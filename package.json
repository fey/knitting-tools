{
  "name": "knitting-tools",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "browsers": "playwright install --with-deps chromium",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=functional --project=desktop",
    "test:screens": "playwright test --project=screens",
    "test:screens:update": "playwright test --project=screens -u",
    "og": "playwright test --project=social",
    "lint:commits": "commitlint --from origin/main --to HEAD --verbose"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "~1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "lefthook": "^2.1.14",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  },
  "allowScripts": {
    "lefthook": true
  }
}
